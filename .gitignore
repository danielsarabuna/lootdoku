*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables — built remote content lives in Supabase Storage CDN, not in git.
# `addressables_content_state.bin` is intentionally tracked (required for ContentUpdateScript).
/[Ss]erver[Dd]ata/
# GUID-named build output directories written to repo root by the packed build pipeline
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
# Addressables state & DefaultObject guard
/Assets/AddressableAssetsData/DefaultObject.asset
/Assets/AddressableAssetsData/DefaultObject.asset.meta

# Per-developer local saves (Editor)
/[Aa]ssets/SaveData/

# Captured logcat dumps (never ship these)
/[Ll]ogcat*[Dd]ump.*
/logcat*.txt

# Unity/Bee temporary directory (sometimes written to repo root)
/.utmp/

# Per-developer local Claude Code settings (may contain secrets)
.claude/settings.local.json

# Local debug/file logs — written to <project>/Logs in Editor (outside Assets)
/Logs/
# Legacy location (logs used to be written into Assets/); keep ignored for old checkouts
/Assets/debug_log.txt
/Assets/debug_log.txt.meta

# AI agent session artifacts (Debug Mode and Goal Mode working folders)
/.debug/
/.goal/
/.agents/
/test-results.xml
/*.log
